{
  "excludePatterns": [
    "fx_sun*", "fx_*",
    "*_lm.*", "*_cm.*", "*_nm2.*",
    "*detail_map*", "*_hm.*"
  ],
  "profiles": [
    {
      "name": "Normal Maps",
      "format": "BC5_UNORM",
      "generateMips": true,
      "patterns": [
        "*_bump.*", "*_bump#.*", "*_normal.*", "*_nm.*", "*_nmap.*",
        "*_nrm.*", "*_norm.*", "*_norm_*", "*nbump*", "*_normalbump.*", "*_nm_*"
      ]
    },
    {
      "name": "UI / Icons",
      "format": "BC3_UNORM",
      "generateMips": false,
      "patterns": ["*/textures/ui/*", "*_icons.*"]
    },
    {
      "name": "Diffuse / Color",
      "format": "BC3_UNORM",
      "generateMips": true,
      "patterns": [
        "*_d.*", "*_diff.*", "*_diffuse.*",
        "*_albedo.*", "*_base.*",
        "*_col.*", "*_color.*", "*_co.*",
        "*_c.*", "*_b.*", "*_rgb.*",
        "*_details.*"
      ]
    },
    {
      "name": "Specular / Gloss",
      "format": "BC3_UNORM",
      "generateMips": true,
      "patterns": ["*_spec.*", "*_gloss.*"]
    },
    {
      "name": "Masks / Alpha",
      "format": "BC3_UNORM",
      "generateMips": true,
      "patterns": ["*_mask.*", "*_alpha.*"]
    }
  ]
}
