{
    "_note": "Profile order matters \u2014 first match wins. Specific path patterns (ui/readables, flares) must precede general ones (ui/*, fx_*). BC7_UNORM for everything except Normal Maps (BC5_UNORM \u2014 required for correct engine lighting, do not change). BC7 is CPU-intensive on Linux/macOS (no GPU acceleration); expect much slower compression than BC3. Will use GPU acceleration on Windows.",
    "minFileSizeBytes": 1024,
    "excludePatterns": [
        "fx_sun*",
        "fx_*",
        "*_lm.*",
        "*_cm.*",
        "*_nm2.*",
        "*detail_map*",
        "*_hm.*",
        "lut_*",
        "*#small*",
        "*cube#*",
        "*_cube#*",
        "*/textures/ui/SquareDOV/*",
        "ui_font_*",
        "cursor_*",
        "*/textures/ui/alticons/*",
        "*/textures/ui/absui_arrows.*",
        "*/textures/ui/arm_radial_menu.*",
        "*/textures/ui/enhancedGUI/*",
        "*/textures/ui/nerfs/*",
        "*/textures/ui/paw/*",
        "*/textures/ui/qaw_*",
        "*/textures/ui/sidhud/*",
        "*/textures/ui/ui_haruka_*",
        "*/textures/ui/ui_magnifier2.*"
    ],
    "profiles": [
        {
            "name": "UI Readables",
            "format": "BC7_UNORM",
            "generateMips": false,
            "patterns": [
                "*/textures/ui/readables/*",
                "*/textures/ui/npe/*"
            ]
        },
        {
            "name": "Flares / FX",
            "format": "BC7_UNORM",
            "generateMips": false,
            "patterns": [
                "*/textures/anamflares/*",
                "*/textures/flares/*"
            ]
        },
        {
            "name": "Particle / FX",
            "format": "BC7_UNORM",
            "generateMips": false,
            "patterns": [
                "*/textures/semitone/*"
            ]
        },
        {
            "name": "Normal Maps",
            "format": "BC5_UNORM",
            "generateMips": true,
            "exclude": [
                "*scope*bump*",
                "*lens_bump*"
            ],
            "patterns": [
                "*_bump.*",
                "*_bump#.*",
                "*_normal.*",
                "*_nm.*",
                "*_nmap.*",
                "*_nrm.*",
                "*_norm.*",
                "*_norm_*",
                "*nbump*",
                "*_normalbump.*",
                "*_nm_*"
            ]
        },
        {
            "name": "Custom UI",
            "format": "BC7_UNORM",
            "generateMips": false,
            "patterns": [
                "*/textures/catsy/*"
            ]
        },
        {
            "name": "UI / Icons",
            "format": "BC7_UNORM",
            "generateMips": false,
            "patterns": [
                "*/textures/ui/*",
                "*_icons.*"
            ]
        },
        {
            "name": "Diffuse / Color",
            "format": "BC7_UNORM",
            "generateMips": true,
            "exclude": [
                "*scope*diff*"
            ],
            "patterns": [
                "*_d.*",
                "*_diff.*",
                "*_diffuse.*",
                "*_albedo.*",
                "*_base.*",
                "*_col.*",
                "*_color.*",
                "*_co.*",
                "*_c.*",
                "*_b.*",
                "*_rgb.*",
                "*_details.*"
            ]
        },
        {
            "name": "Specular / Gloss",
            "format": "BC7_UNORM",
            "generateMips": true,
            "patterns": [
                "*_spec.*",
                "*_gloss.*"
            ]
        },
        {
            "name": "Masks / Alpha",
            "format": "BC7_UNORM",
            "generateMips": true,
            "patterns": [
                "*_mask.*",
                "*_alpha.*"
            ]
        },
        {
            "name": "Sky Textures",
            "format": "BC7_UNORM",
            "generateMips": true,
            "patterns": [
                "*/textures/sky/*"
            ]
        },
        {
            "name": "Detail / Terrain",
            "format": "BC7_UNORM",
            "generateMips": true,
            "patterns": [
                "*/textures/detail/*",
                "*/textures/terrain/*"
            ]
        },
        {
            "name": "Sights / Reticles",
            "format": "BC7_UNORM",
            "generateMips": false,
            "patterns": [
                "*/textures/wpn/scope_reticles/*",
                "*/textures/bonus_sights/*",
                "*crosshair*",
                "*reticle*",
                "*_reticle.*",
                "*_crosshair.*"
            ]
        },
        {
            "name": "Scope Textures",
            "format": "BC7_UNORM",
            "generateMips": true,
            "patterns": [
                "*/textures/wpn/scope_*",
                "*scope*diff*",
                "*scope*bump*",
                "*lens_bump*"
            ]
        },
        {
            "name": "Weapon Textures",
            "format": "BC7_UNORM",
            "generateMips": true,
            "patterns": [
                "*/textures/wpn/*",
                "*/textures/rwap/*"
            ]
        },
        {
            "name": "Character / Hands",
            "format": "BC7_UNORM",
            "generateMips": true,
            "patterns": [
                "*/textures/act/*",
                "*/textures/MK/*"
            ]
        },
        {
            "name": "Items",
            "format": "BC7_UNORM",
            "generateMips": true,
            "patterns": [
                "*/textures/items/*",
                "*/textures/item/*",
                "*/textures/usable_items/*",
                "*/textures/farcry4/*",
                "*/textures/artifact/*",
                "*/textures/gwr/*"
            ]
        }
    ]
}